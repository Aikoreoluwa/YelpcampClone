<% layout("layouts/boilerplate") %>
    <div class="container min-vh-100 d-flex justify-content-center align-items-center">
        <div class="row w-100"> <!-- Ensure row spans full width -->
            <div class="col-md-6 col-xl-4 mx-auto"> <!-- Simplified column logic -->
                <div class="card shadow">
                    <img src="https://images.unsplash.com/photo-1515876305430-f06edab8282a?w=500&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8NjB8fGNhbXBpbmd8ZW58MHx8MHx8fDA%3D"
                        alt="" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">Login</h5>
                        <form action="/login" method="post" class="validated-form" novalidate>
                            <div class="mb-3">
                                <label class="form-label" for="username">Username</label>
                                <input class="form-control" type="text" id="username" name="username" autofocus
                                    required>
                                <div class="valid-feedback">
                                    Looks good!
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="password">Password</label>
                                <input class="form-control" type="password" id="password" name="password" required>
                                <div class="valid-feedback">
                                    Looks good!
                                </div>
                            </div>
                            <div class="d-grid">
                                <button class="btn btn-success w-100">Login</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>